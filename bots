#!/bin/sh
# Manage the Hermes Gateway and File Watcher on macOS.
# Usage: ./bots {init|start|stop|cancel|clean|status|logs|console|uninstall|help}
set -eu

LABEL='local.hermes.file-watcher'
DOMAIN="gui/$(id -u)"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WATCHER_DIR="$SCRIPT_DIR"
BIN_DIR="$WATCHER_DIR/bin"
CLI_SCRIPT="$SCRIPT_DIR/$(basename "$0")"
HERMES_WATCHER_DIR="$WATCHER_DIR"
export HERMES_WATCHER_DIR
PATH="$HOME/.local/bin:$HOME/.hermes/hermes-agent/.hermes/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH

hermes_bin() {
    if command -v hermes >/dev/null 2>&1; then
        command -v hermes
    elif [ -x "$HOME/.hermes/hermes-agent/.hermes/bin/hermes" ]; then
        printf '%s\n' "$HOME/.hermes/hermes-agent/.hermes/bin/hermes"
    else
        echo 'ERROR: Hermes CLI not found.' >&2
        exit 1
    fi
}

ensure_console_click_approval() {
    HERMES=$1
    CLICK_APPROVAL='cua:click:background'
    CONSOLE_PROFILES=$(configured_profiles team)
    if [ -z "$CONSOLE_PROFILES" ]; then
        echo 'ERROR: config.json team.profiles is empty; no console targets are available.' >&2
        return 1
    fi

    echo 'Ensuring background-click approval for configured team profiles...'
    for profile in $CONSOLE_PROFILES; do
        allowlist=$("$HERMES" -p "$profile" config get command_allowlist --json) || {
            echo "ERROR: Could not read Hermes approvals for profile '$profile'." >&2
            return 1
        }
        updated=$(/usr/bin/python3 -c '
import json
import sys

value = json.loads(sys.argv[1])
if not isinstance(value, list) or not all(isinstance(item, str) for item in value):
    raise SystemExit("command_allowlist must be a list of strings")
entry = sys.argv[2]
if entry not in value:
    value.append(entry)
print(json.dumps(value))
' "$allowlist" "$CLICK_APPROVAL") || {
            echo "ERROR: Invalid command_allowlist for Hermes profile '$profile'." >&2
            return 1
        }
        if [ "$updated" != "$allowlist" ]; then
            "$HERMES" -p "$profile" config set command_allowlist "$updated" || {
                echo "ERROR: Could not save background-click approval for profile '$profile'." >&2
                return 1
            }
        fi
    done
}

export_latest_agent_message() {
    HERMES=$1
    PROFILE=$2
    SESSION_NAME=$3
    EXPORT_FILE=$4
    MESSAGE_FILE=$5

    if ! "$HERMES" -p "$PROFILE" sessions export --format jsonl \
        --title "$SESSION_NAME" - > "$EXPORT_FILE"; then
        return 1
    fi
    /usr/bin/python3 - "$SESSION_NAME" "$EXPORT_FILE" "$MESSAGE_FILE" <<'PYLATEST'
import json
import sys
from pathlib import Path

session_name = sys.argv[1]
export_file = Path(sys.argv[2])
message_file = Path(sys.argv[3])
session = None
for raw in export_file.read_text(encoding='utf-8').splitlines():
    if not raw.strip():
        continue
    record = json.loads(raw)
    if record.get('title') == session_name:
        session = record
        break

latest = None
for message in reversed((session or {}).get('messages') or []):
    content = message.get('content')
    if message.get('role') == 'assistant' and isinstance(content, str) and content.strip():
        latest = content.rstrip()
        break

if latest is None:
    raise SystemExit(1)
message_file.write_text(latest, encoding='utf-8')
PYLATEST
}

show_latest_agent_message() {
    HERMES=$1
    PROFILE=$2
    SESSION_NAME=$3
    EXPORT_FILE=$4
    MESSAGE_FILE=$5

    printf '\nMost recent agent message:'
    if export_latest_agent_message "$HERMES" "$PROFILE" "$SESSION_NAME" \
        "$EXPORT_FILE" "$MESSAGE_FILE"; then
        printf '\n'
        /bin/cat "$MESSAGE_FILE"
        printf '\n\n'
    else
        printf ' (none yet)\n\n'
    fi
}

copy_file_to_clipboard() {
    CLIPBOARD_FILE=$1
    if command -v pbcopy >/dev/null 2>&1; then
        if pbcopy < "$CLIPBOARD_FILE" && command -v pbpaste >/dev/null 2>&1; then
            EXPECTED_CLIPBOARD=$(/bin/cat "$CLIPBOARD_FILE")
            ACTUAL_CLIPBOARD=$(pbpaste 2>/dev/null || true)
            if [ "$ACTUAL_CLIPBOARD" = "$EXPECTED_CLIPBOARD" ]; then
                return 0
            fi
        fi
        # pbcopy can return success without reaching the logged-in user's GUI
        # pasteboard (notably from some tmux/bootstrap contexts). AppleScript
        # targets that pasteboard directly; verify it through pbpaste as well.
        if command -v osascript >/dev/null 2>&1 && \
           osascript \
               -e 'on run argv' \
               -e 'set the clipboard to (read POSIX file (item 1 of argv) as «class utf8»)' \
               -e 'end run' \
               "$CLIPBOARD_FILE" >/dev/null 2>&1; then
            EXPECTED_CLIPBOARD=$(/bin/cat "$CLIPBOARD_FILE")
            ACTUAL_CLIPBOARD=$(pbpaste 2>/dev/null || true)
            [ "$ACTUAL_CLIPBOARD" = "$EXPECTED_CLIPBOARD" ] && return 0
        fi
        return 1
    elif command -v wl-copy >/dev/null 2>&1; then
        wl-copy < "$CLIPBOARD_FILE"
    elif command -v xclip >/dev/null 2>&1; then
        xclip -selection clipboard < "$CLIPBOARD_FILE"
    elif command -v xsel >/dev/null 2>&1; then
        xsel --clipboard --input < "$CLIPBOARD_FILE"
    elif command -v clip.exe >/dev/null 2>&1; then
        clip.exe < "$CLIPBOARD_FILE"
    else
        return 1
    fi
}

